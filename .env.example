# Copy this file to .env and fill in your Stripe test keys.
# Never commit .env or put secret keys in client-side code.

# Required to enable the tip jar. Use a test key (sk_test_...) until you go live.
STRIPE_SECRET_KEY=

# Required to verify Stripe webhooks. Get this from `stripe listen` locally,
# or from the Stripe Dashboard webhook details in production.
STRIPE_WEBHOOK_SECRET=

# Public site URL used for Stripe success/cancel redirects.
# In production set this to your HTTPS origin, e.g. https://your-app.onrender.com
# If omitted, the server derives it from the incoming request.
BASE_URL=

# Port to listen on (Render, Railway, and Fly set this automatically).
PORT=3000

# Set to production on a public host so HTTPS-only headers are enabled.
NODE_ENV=development
